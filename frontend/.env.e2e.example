# Copie para .env.e2e (ignorado pelo git) se precisar mudar algum valor.
# Por padrão o globalSetup do Playwright chama POST {BACKEND_URL}/api/e2e/seed
# e preenche todas as variáveis E2E_* abaixo com dados novos a cada execução.

# Front (Next) e backend (Spring no perfil e2e)
E2E_BASE_URL=http://localhost:3001
BACKEND_URL=http://localhost:8081

# true (padrão): gera os dados pelo seed. false: usa os valores definidos abaixo.
E2E_SEED=true

# Só são lidos com E2E_SEED=false
# Tutor da sala (E2E_TUTOR_ID é o mesmo valor de E2E_USER_ID)
E2E_USER_ID=
E2E_TUTOR_ID=
E2E_TUTOR_NAME=
# Tutor de outra sala, que não é tutor da sala de E2E_ROOM_ID
E2E_OTHER_TUTOR_ID=
# Sala do tutor, com ao menos 40 alunos ativos, incluindo os alunos A e B
E2E_ROOM_ID=
# Problema da sala
E2E_PROBLEM_ID=
# Sessão do problema SEM papéis atribuídos (US10 não permite remover papéis: use uma nova a cada execução)
E2E_SESSION_ID=
# Tabela de desempenho da sala com os critérios Conteúdo, Participação e Autoavaliação somando 100%
E2E_PERFORMANCE_TABLE_ID=
# Autoavaliação do aluno A NUNCA ajustada (US15 não permite desfazer: use uma nova a cada execução)
E2E_ASSESSMENT_ID=
# Nota enviada na autoavaliação, diferente de 8.5 e 10
E2E_ORIGINAL_GRADE=
# Aluno A e aluno B, ambos ativos na sala
E2E_STUDENT_ID=
E2E_STUDENT_NAME=
E2E_OTHER_STUDENT_ID=
E2E_OTHER_STUDENT_NAME=

# Cadastro de Usuário (US01)
E2E_REGISTER_USER_NAME=Usuário Teste QA
E2E_REGISTER_EMAIL=usuario.qa.e2e@uefs.br
E2E_REGISTER_PASSWORD=SenhaForte@2026

# Disciplina da sala E2E_ROOM_ID (onde a US05 cria problemas)
E2E_DISCIPLINE_ID=